# /etc/nexup-bridge/deploy.env
# chmod 600, owner root. No secret is stored here: it holds the three values the
# deployment DEFINITION interpolates, so it must be readable by the supervisor.
#
# Loaded twice, on purpose:
#   1. by the operator's root shell before any manual `docker compose` call
#      (runbook §2 install step);
#   2. by `deploy/systemd/nexup-bridge-supervisor.service` through
#      `EnvironmentFile=`, because the supervisor's own recovery path runs
#      `docker compose -f ... up -d` to re-create the bridge after the Hermes
#      container is re-created. Without this file the unit's `compose up` cannot
#      interpolate `image:` and exits 1 — MEASURED on the real daemon:
#      `env -i docker compose -f docker-compose.bridge.yml config` →
#      "required variable NEXUP_BRIDGE_IMAGE is missing a value".

# THE image identity, and the ONLY one. A tag is not an identity; the digest is.
# `docker-compose.bridge.yml` interpolates this line and embeds no digest of its
# own, so this value and the build record cannot drift apart silently — preflight
# resolves what is written here (`docker compose config`) and compares it with the
# digest recorded at build time (P0.5b/P0.2b).
#
# Read it back for the pre-flight from this installed file, never from memory:
#   EXPECTED=$(awk -F'@' '/^NEXUP_BRIDGE_IMAGE=/{print $2}' /etc/nexup-bridge/deploy.env)
#   IMAGE=$(awk -F= '/^NEXUP_BRIDGE_IMAGE=/{print $2}' /etc/nexup-bridge/deploy.env)
#
# The build this value came from (input, for traceability only — not an identity):
#   bundle  dist/main.js  sha256 1136425b17e1fa1204f1d74694db7580866b2d5f0216ccb8c6930c9ec73b4a4f, 75,408 B
#
# A rebuilt bundle produces a different image digest: update THIS line, re-install
# the file, and update the bundle row in the runbook's P0 record in the same
# commit. Do not restate the digest anywhere else.
NEXUP_BRIDGE_IMAGE=nexup-bridge@sha256:2004387ab49a4b72b64ae763be21251d892b9ddb97cb87e768eeffbbaec024e3

# The public hostname Traefik serves the bridge on. Must match the router rule
# the pre-flight reads (P0.7b) and the hostname the signer calls.
NEXUP_BRIDGE_HOSTNAME=bridge.example.invalid

# The Docker container NAME (or compose alias) of the managed Hermes container.
# Never an ID and never an IP: the ID changes on every recreation and Docker
# renumbers the network with it. Defaults to
# `hermes-agent-r3j1-hermes-agent-1` when unset, which is what the unit and the
# compose file both assume.
# NEXUP_HERMES_CONTAINER=hermes-agent-r3j1-hermes-agent-1
