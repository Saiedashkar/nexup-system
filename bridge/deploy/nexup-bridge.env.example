# /etc/nexup-bridge/bridge.env
# chmod 600, owner root. Contains secrets — never commit a filled copy.
# Loaded by the bridge CONTAINER via `env_file:` in docker-compose.bridge.yml.
# Never passed on a command line, and never rendered by `docker inspect` of the
# container's own configuration in a way that survives a restart.

NEXUP_BRIDGE_ENABLED=true
NEXUP_BRIDGE_PORT=9220

# The bridge is its own container SHARING the Hermes container's network
# namespace, so inside that namespace it must bind the namespace's private
# interface — that is where Traefik reaches it (Traefik follows `NetworkMode` to
# the owner's address). Nothing is published on the host: the compose file has
# no `ports:` at all.
#
# The opt-in is narrow on purpose and is refused unless the trusted edge is
# named below as well.
NEXUP_BRIDGE_HOST=0.0.0.0
NEXUP_BRIDGE_ALLOW_NON_LOOPBACK_BIND=true

# Shared with Vercel. Generate 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXUP_BRIDGE_HMAC_SECRET=replace-with-32-plus-random-bytes
# Comma-separated to allow key rotation.
NEXUP_BRIDGE_ALLOWED_KEY_IDS=nexup-vercel

NEXUP_BRIDGE_TIMEOUT_MS=120000
NEXUP_BRIDGE_MAX_OUTPUT_BYTES=262144
NEXUP_BRIDGE_MAX_CONCURRENCY=4
NEXUP_BRIDGE_RATE_LIMIT_PER_MINUTE=60
# Pre-authentication limits, applied before signature verification.
NEXUP_BRIDGE_PREAUTH_PER_REMOTE_PER_MINUTE=120
NEXUP_BRIDGE_PREAUTH_GLOBAL_PER_MINUTE=600
NEXUP_BRIDGE_CLOCK_SKEW_SECONDS=300
# The request-body cap. There is NO edge body cap any more: Traefik core has no
# request-body limit without a plugin, and the only built-in that has one
# (`buffering`) would buffer the SSE run stream. The bridge is therefore the
# control of record — a larger value here is the real limit.
NEXUP_BRIDGE_MAX_BODY_BYTES=262144

# Client identity. Off-loopback the TCP peer can never be loopback, so the
# boundary MUST be named: here it is the Docker network the bridge shares.
# Docker renumbers that network whenever the Hermes container is re-created
# (172.16.x.0/24 changed twice in Gate 0), so a network is used rather than one
# address that would rot.
#
# The address header is X-Forwarded-For because Traefik cannot overwrite an
# arbitrary header with the peer address: it APPENDS the peer it saw. The bridge
# reads the RIGHTMOST element for exactly that reason — everything to its left
# is caller-supplied and is ignored, so a spoofed prefix cannot mint a fresh
# pre-auth bucket.
NEXUP_BRIDGE_TRUSTED_PROXIES=172.16.0.0/16
NEXUP_BRIDGE_CLIENT_IP_HEADER=x-forwarded-for

# Hermes transport — LOOPBACK ONLY, unchanged by the container topology: the
# bridge reaches the serve endpoint over the namespace's own loopback.
# HERMES_DASHBOARD_SESSION_TOKEN must be set to a FIXED value on the serve
# process; the supervisor reads the same value from
# /etc/nexup-bridge/hermes-session-token (root-only, 0600) and mirrors it here.
# A per-start random token (the current unmanaged state) is unusable: the bridge
# would have to be re-keyed on every restart.
HERMES_RPC_URL=ws://127.0.0.1:9119/api/ws
HERMES_SESSION_TOKEN=replace-with-HERMES_DASHBOARD_SESSION_TOKEN
HERMES_ORIGIN=http://127.0.0.1:9119

# The single profile in scope. HERMES_PROFILE must be IN this allowlist, and the
# allowlist is what the config honours — so widening it is what would make
# another profile (e.g. `adel`, which names the same /opt/data root as `default`)
# addressable. `default` can never appear here: the config refuses it outright.
# Verified against the real daemon: before this allowlist existed, the image
# accepted HERMES_PROFILE=adel and served 401s.
HERMES_PROFILE=saieed
NEXUP_BRIDGE_ALLOWED_PROFILES=saieed
