{
  "name": "nexup-vps-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Secure NEXUP VPS Bridge — the only public surface in front of a loopback-only Hermes runtime.",
  "scripts": {
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "build": "npx esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.js --alias:@=../src --log-level=warning",
    "build:cli": "npx esbuild src/release/cli.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/release-cli.js --alias:@=../src --log-level=warning",
    "release:preflight": "node dist/release-cli.js preflight",
    "release:compat": "node dist/release-cli.js hermes-compat",
    "start": "node dist/main.js",
    "test": "npx vitest run --config vitest.config.ts"
  }
}
