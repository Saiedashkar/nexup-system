[Unit]
Description=NEXUP VPS Bridge (authenticated gateway to a loopback-only Hermes)
Documentation=https://github.com/Saiedashkar/nexup-system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexup-bridge
Group=nexup-bridge
WorkingDirectory=/opt/nexup-bridge
EnvironmentFile=/etc/nexup-bridge/bridge.env
ExecStart=/usr/bin/node /opt/nexup-bridge/dist/main.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

# Hardening: the bridge only makes outbound loopback connections and serves a
# single local HTTP port; it needs no privileges and no writable filesystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_UNIX is included because Node resolves through/uses unix sockets for
# normal system operation (nss, logging); AF_INET/AF_INET6 carry the traffic.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# NOTE: MemoryDenyWriteExecute is deliberately NOT set. V8 requires W→X page
# transitions for JIT; this option makes Node abort at startup or run
# pathologically. The bridge is not made JIT-less (`--jitless`) instead.
CapabilityBoundingSet=

LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
