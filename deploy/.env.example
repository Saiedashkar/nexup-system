# ═══════════════════════════════════════════════════════════════════════════
# NAMES ONLY — no values, no secrets, nothing that can be reused.
# ═══════════════════════════════════════════════════════════════════════════
#
# Two files are installed on the host, both 0600 and owned by the account that
# runs the stack:
#
#   /etc/nexup-command/app.env    (the application)
#   /etc/nexup-command/db.env     (the database container)
#
# `deploy/compose.yml` reads them by that absolute path. The values are typed on
# the host by the operator; this file is the checklist of what must exist.
#
# app.env
DATABASE_URL=postgresql://command:<PASSWORD>@db:5432/command
DATABASE_SSL_DISABLE=1
AUTH_SECRET=<openssl rand -hex 32 — at least 32 characters>
NODE_ENV=production
TRIAL_READ_ONLY=1
# PORT=3000
# HOSTNAME=0.0.0.0
# Optional: receipt uploads. Without all five the feature stays off and says so;
# nothing else in the app depends on them.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_PUBLIC_URL=
#
# Deliberately ABSENT (a private trial does not run a model provider):
#   HERMES_RUNTIME_*  NEXUP_BRIDGE_*  HERMES_SESSION_TOKEN  HERMES_PROFILE
# With them unset the workforce runtime is not registered at all, and
# TRIAL_READ_ONLY=1 additionally closes /api/exec and /api/ai-workforce.

# db.env
POSTGRES_DB=command
POSTGRES_USER=command
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_INITDB_ARGS=--data-checksums

# shell env for `docker compose` itself (never stored in this repository)
COMMAND_IMAGE=nexup-command@sha256:<digest from docker image inspect>
EDGE_NETWORK=<the proxy's docker network name>
COMMAND_HOSTNAME=command.<DOMAIN>
TRAEFIK_CERT_RESOLVER=le
