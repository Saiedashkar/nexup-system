generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN   // Office owner — sees all businesses
  ADMIN         // Business manager — full access to one business
  EMPLOYEE      // Staff — clients only, within one business
}

enum CurrencyMode {
  SAR_TO_EGP   // Saudi Riyal → Egyptian Pound (NEXUP)
  EGP_DIRECT   // Egyptian Pound direct (REBOUND, ABOMAZEN)
}

enum ClientTier {
  VIP
  LOYAL
  NORMAL
  DELINQUENT
}

enum WorkStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum PaymentStatus {
  FULL
  PARTIAL
  UNPAID
}

enum PoolTransactionType {
  IN
  OUT
}

enum ExpenseCategory {
  FIXED
  VARIABLE
}

enum ClientType {
  ONE_TIME    // One-time service
  RECURRING   // Monthly subscription
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  PARTIAL
}

// ═══════════════════════════════════════════════════════
// Business (multi-business support)
// ═══════════════════════════════════════════════════════

model Business {
  id            String         @id @default(cuid())
  name          String         @unique  // "NEXUP", "REBOUND", "ABOMAZEN"
  slug          String         @unique  // "nexup", "rebound", "abomazen"
  currencyMode  CurrencyMode   @default(SAR_TO_EGP)
  createdAt     DateTime       @default(now())

  // Relations — each business has its own isolated data
  users             User[]
  clients           Client[]
  serviceTypes      ServiceType[]
  projectRecords    ProjectRecord[]
  poolTransactions  PoolTransaction[]
  withdrawals       Withdrawal[]
  expenses          Expense[]
  // Subscription relations
  subscriptions          Subscription[]
  // ABOMAZEN relations
  properties             Property[]
  deals                  Deal[]
  // Office admin relations
  ownerships             BusinessOwnership[]
  partnerTransactions    PartnerTransaction[]
  allocationSettings     OfficeAllocationSetting[]
  profitTransfers        ProfitTransfer[]

  @@index([slug])
}

// ═══════════════════════════════════════════════════════
// Core Models
// ═══════════════════════════════════════════════════════

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role            @default(EMPLOYEE)
  businessId     String?         // null for SUPER_ADMIN (sees all)
  // ─── Permission Flags ───
  canAccessNexup            Boolean @default(false)
  canAccessRebound          Boolean @default(false)
  canAccessAbomazen         Boolean @default(false)
  canAccessOfficeFinanceFull Boolean @default(false)
  mustChangePassword Boolean @default(false)
  createdAt      DateTime        @default(now())
  business       Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  projectRecords ProjectRecord[] @relation("DesignerProjects")
  activityLogs   ActivityLog[]

  @@index([role])
  @@index([businessId])
}

model Client {
  id             String          @id @default(cuid())
  businessId     String
  phone          String          // Not unique globally — unique per business
  name           String
  tier           ClientTier      @default(NORMAL)
  createdAt      DateTime        @default(now())
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecords ProjectRecord[]
  subscriptions  Subscription[]

  @@unique([businessId, phone])
  @@index([name])
  @@index([businessId])

  // Soft delete (safe delete — never destroy real financial data)
  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model ServiceType {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  isCustom       Boolean         @default(false)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecords ProjectRecord[]

  @@unique([businessId, name, isCustom])
  @@index([businessId])
}

model ProjectRecord {
  id               String            @id @default(cuid())
  businessId       String
  clientId         String
  projectName      String
  date             DateTime
  customServiceText String?
  totalPrice       Decimal           @db.Decimal(12, 2)
  deposit          Decimal           @default(0) @db.Decimal(12, 2)
  remaining        Decimal           @default(0) @db.Decimal(12, 2)
  workStatus       WorkStatus        @default(WAITING)
  paymentStatus    PaymentStatus     @default(UNPAID)
  designerId       String?
  designerName     String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  designer         User?             @relation("DesignerProjects", fields: [designerId], references: [id], onDelete: Restrict)
  services         ServiceType[]
  poolTransactions PoolTransaction[]
  payments         ClientPayment[]
  clientType       ClientType        @default(ONE_TIME)

  @@index([businessId])
  @@index([clientId])
  @@index([designerId])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model PoolTransaction {
  id              String              @id @default(cuid())
  businessId      String
  projectRecordId String?
  dealId          String?
  withdrawalId    String?             @unique
  amountSAR       Decimal             @db.Decimal(12, 2)
  type            PoolTransactionType
  date            DateTime
  note            String?
  createdAt       DateTime            @default(now())
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecord   ProjectRecord?      @relation(fields: [projectRecordId], references: [id], onDelete: SetNull)
  deal            Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  withdrawal      Withdrawal?         @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([projectRecordId])
  @@index([type])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model Withdrawal {
  id              String           @id @default(cuid())
  businessId      String
  amountSAR       Decimal          @db.Decimal(12, 2)
  exchangeRate    Decimal          @db.Decimal(12, 4)
  commissionPct   Decimal          @default(10) @db.Decimal(5, 2)
  netEGP          Decimal          @db.Decimal(14, 2)
  date            DateTime
  month           Int
  year            Int
  createdAt       DateTime         @default(now())
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  poolTransaction PoolTransaction?

  @@index([businessId])
  @@index([year, month])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model Expense {
  id          String          @id @default(cuid())
  businessId  String
  description String
  cost        Decimal         @db.Decimal(14, 2)
  category    ExpenseCategory
  name        String
  notes       String?
  date        DateTime
  month       Int
  year        Int
  createdAt   DateTime        @default(now())
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([year, month])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model ClientPayment {
  id              String          @id @default(cuid())
  projectRecordId String
  amount          Decimal         @db.Decimal(12, 2)
  date            DateTime
  note            String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  projectRecord   ProjectRecord   @relation(fields: [projectRecordId], references: [id], onDelete: Restrict)
  receipts        PaymentReceipt[]

  @@index([projectRecordId])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model PaymentReceipt {
  id               String        @id @default(cuid())
  clientPaymentId  String
  imageUrl         String
  fileName         String?
  fileSize         Int?
  mimeType         String?
  uploadedAt       DateTime      @default(now())
  uploadedByUserId String?
  clientPayment    ClientPayment @relation(fields: [clientPaymentId], references: [id], onDelete: Cascade)

  @@index([clientPaymentId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

// ═══════════════════════════════════════════════════════
// Office Administration Layer (SUPER_ADMIN only)
// ═══════════════════════════════════════════════════════

enum PartnerTransactionType {
  SALARY          // Fixed monthly salary
  PROFIT_SHARE    // Share of distributed profits
  ADVANCE         // Cash advance (deducted from future earnings)
  WITHDRAWAL      // Normal withdrawal
  LOAN_SETTLEMENT // Settlement/deduction of previous advance
}

enum CapitalType {
  CASH
  ASSET
}

enum FundFlow {
  SPENT_ALREADY     // Money was spent immediately — does NOT add to treasury
  STILL_IN_TREASURY // Money is available as real cash in the office treasury
}

enum ExpenseCat {
  FIXED
  VARIABLE
}

model Partner {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  ownerships          BusinessOwnership[]
  transactions        PartnerTransaction[]
  capitalContributions CapitalContribution[]
  capitalWithdrawals  CapitalSpend[] @relation("CapitalWithdrawals")
  nexupProfitDistributions NexupProfitLedger[]
}

/// Classification of a CapitalSpend movement. All types reduce the
/// Available Capital balance the same way — the type is bookkeeping
/// context, not a different accounting pool.
enum CapitalSpendType {
  EXPENSE
  PERSON_WITHDRAWAL
  CUSTODY
}

model BusinessOwnership {
  id            String   @id @default(cuid())
  partnerId     String
  businessId    String
  ownershipPct  Float    // percentage 0-100
  effectiveDate DateTime @default(now())
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([partnerId, businessId, effectiveDate])
  @@index([partnerId])
  @@index([businessId])
}

model PartnerTransaction {
  id          String                @id @default(cuid())
  partnerId   String
  type        PartnerTransactionType
  amount      Float
  date        DateTime
  businessId  String?               // null = general office transaction
  note        String?
  createdAt   DateTime              @default(now())
  partner     Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  business    Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([businessId])
  @@index([date])
  @@index([type])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model OfficeExpense {
  id          String     @id @default(cuid())
  description String
  cost        Float
  category    ExpenseCat
  name        String     // recipient/person
  notes       String?
  date        DateTime
  month       Int
  year        Int
  createdAt   DateTime   @default(now())
  fixedExpenseId String?  // set when this row was generated by a recurring FixedExpense
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)

  @@index([year, month])
  @@index([date])
  @@unique([fixedExpenseId, year, month])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model CapitalContribution {
  id               String      @id @default(cuid())
  partnerId        String
  amount           Float
  type             CapitalType
  fundFlow         FundFlow    @default(SPENT_ALREADY)
  description      String?
  date             DateTime
  linkedExpenseId  String?     // Auto-created OfficeExpense ID (for SPENT_ALREADY)
  currency         String      @default("EGP")
  reference        String?
  createdAt        DateTime    @default(now())
  partner          Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  spends           CapitalSpend[]

  @@index([partnerId])
  @@index([date])
  @@index([fundFlow])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

/// One office capital fund: money received from funders (CapitalContribution)
/// minus money spent from that fund (CapitalSpend). Deliberately separate from
/// the operating treasury: contributions never touch Revenue/Profit/treasury,
/// and capital spending reduces the capital balance only.
model CapitalSpend {
  id              String   @id @default(cuid())
  amount          Float
  date            DateTime
  category        String
  description     String
  notes           String?
  reference       String?
  // Classification: EXPENSE (default — all historical rows),
  // PERSON_WITHDRAWAL (a person took money from the capital fund),
  // CUSTODY (money held on behalf of a person — tracking only).
  // All three reduce Available Capital identically.
  spendType       CapitalSpendType @default(EXPENSE)
  // PERSON_WITHDRAWAL / CUSTODY recipient. Optional link to the Partner
  // entity for per-person reporting — deliberately NOT the profit
  // accounting system (no PartnerTransaction / ProfitTransfer involved).
  // recipientName keeps a readable snapshot so historical rows stay
  // understandable even if the partner's display name changes later.
  recipientPartnerId String?
  recipientPartner Partner? @relation("CapitalWithdrawals", fields: [recipientPartnerId], references: [id], onDelete: SetNull)
  recipientName   String?
  contributionId  String?  // optional attribution to a specific funding entry
  contribution    CapitalContribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  fixedExpenseId  String?  @unique // set when converted to a recurring Fixed Expense
  fixedExpense    FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  convertedAt     DateTime? // when the spend was converted to a recurring expense
  createdAt       DateTime @default(now())

  @@index([date])
  @@index([contributionId])
  @@index([spendType])
  @@index([recipientPartnerId])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

/// Recurring fixed-expense DEFINITION (the first recurring engine in the app).
/// Occurrences are materialized as OfficeExpense rows (category FIXED) for each
/// due month — idempotent via lastGeneratedMonth + a unique
/// (fixedExpenseId, year, month) constraint. A FixedExpense born from a
/// capital spend always starts the month AFTER that spend so the initial
/// capital-funded payment is never double-counted.
model FixedExpense {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  amount             Float
  frequency          String    @default("MONTHLY")
  startDate          DateTime  // first occurrence month (UTC month bucket)
  lastGeneratedMonth DateTime? // month bucket of the last generated occurrence
  active             Boolean   @default(true)
  createdByUserId    String?
  createdAt          DateTime  @default(now())
  officeExpenses     OfficeExpense[]
  capitalSpend       CapitalSpend?

  @@index([active])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model OfficeAllocationSetting {
  id            String   @id @default(cuid())
  businessId    String
  allocationPct Float    // percentage this business pays of office expenses
  effectiveDate DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, effectiveDate])
  @@index([businessId])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model ProfitTransfer {
  id          String   @id @default(cuid())
  businessId  String
  amount      Float    // EGP transferred from business profit to office treasury
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// NEXUP Profit Distribution (SAIED & ADEL only)
// ═══════════════════════════════════════════════════════

model NexupProfitLedger {
  id          String   @id @default(cuid())
  partnerId   String   // Must be SAIED or ADEL — enforced at API level
  amount      Float    // EGP distributed from NEXUP treasury
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// ABOMAZEN Properties & Deals (Real Estate Brokerage)
// ═══════════════════════════════════════════════════════

model Property {
  id            String    @id @default(cuid())
  businessId    String
  ownerName     String
  ownerPhone    String?
  propertyType  String    // شقة، فيلا، محل... (free text)
  location      String
  listingType   String    @default("RENT") // RENT or SALE
  askingPrice   Float?
  status        String    @default("AVAILABLE") // AVAILABLE, RENTED, SOLD
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deals         Deal[]

  @@index([businessId])
  @@index([status])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model Deal {
  id                   String    @id @default(cuid())
  businessId           String
  propertyId           String?
  dealType             String    // RENT or SALE
  dealValue            Float?
  totalCommission      Float     // Total commission collected (required)
  externalOfficeAmount Float?
  personalAmount       Float?
  abomazenNetAmount    Float     // Net amount that enters ABOMAZEN balance (required)
  date                 DateTime
  seekerName           String?
  seekerPhone          String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  property             Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  poolTransactions     PoolTransaction[]

  @@index([businessId])
  @@index([propertyId])
  @@index([date])
  @@index([dealType])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// REBOUND Subscriptions
// ═══════════════════════════════════════════════════════

model Subscription {
  id            String              @id @default(cuid())
  clientId      String
  businessId    String
  services      String              // JSON array of service names
  monthlyFee    Float
  startDate     DateTime
  billingDay    Int                 @default(1) // Day of month for billing
  status        SubscriptionStatus  @default(ACTIVE)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invoices      SubscriptionInvoice[]

  @@index([clientId])
  @@index([businessId])
  @@index([status])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model SubscriptionInvoice {
  id              String          @id @default(cuid())
  subscriptionId  String
  month           Int
  year            Int
  amount          Float           // Defaults to monthlyFee at generation time
  status          InvoiceStatus   @default(UNPAID)
  paidAmount      Float           @default(0)
  paidDate        DateTime?
  createdAt       DateTime        @default(now())
  subscription    Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, month, year])
  @@index([subscriptionId])
  @@index([month, year])
  @@index([status])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// Office Tools & Equipment (managed from capital)
// ═══════════════════════════════════════════════════════

enum ToolType {
  ONE_TIME            // Purchased once from capital
  MONTHLY_SUBSCRIPTION // Recurring monthly cost
  PERIODIC            // Recurring at irregular intervals
}

enum ToolStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model OfficeTool {
  id              String     @id @default(cuid())
  name            String     // e.g. "Adobe Photoshop", "Office Desk"
  type            ToolType   @default(ONE_TIME)
  category        String     // e.g. "Software", "Hardware", "Furniture"
  cost            Float      // Purchase price or monthly subscription cost
  purchaseDate    DateTime   // When purchased or subscription started
  nextDueDate     DateTime?  // Next payment due (for MONTHLY_SUBSCRIPTION & PERIODIC)
  intervalDays    Int?       // For PERIODIC: days between payments
  status          ToolStatus @default(ACTIVE)
  paidBy          String     @default("CAPITAL") // CAPITAL or PARTNER name
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  payments        OfficeToolPayment[]

  @@index([type])
  @@index([status])
  @@index([category])
  @@index([nextDueDate])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model OfficeToolPayment {
  id          String     @id @default(cuid())
  toolId      String
  amount      Float
  paidDate    DateTime
  notes       String?
  createdAt   DateTime   @default(now())
  tool        OfficeTool @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@index([toolId])
  @@index([paidDate])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// AI WORKFORCE (Phase 1A + 1B — ADDITIVE, NOT YET MIGRATED)
// ═══════════════════════════════════════════════════════
//
// These FOUR tables do NOT exist in any database yet.
//
//   - Nothing above was modified, renamed or removed.
//   - The proposed DDL lives in `prisma/proposed-migrations/` and is NOT part
//     of `prisma/migrations/`, so `prisma migrate deploy` cannot pick it up by
//     accident. It gets moved into place only after an isolated development
//     database is approved.
//   - Phase 1B review: `AiToolInvocation` was removed — a run already IS the
//     tool invocation (one capability per run), so that table would have
//     duplicated `ai_runs` row-for-row.
//   - No foreign keys are declared to `User` / `Business`: adding a relation
//     would require back-relation fields on those existing models. Actor and
//     business ids are stored as plain indexed columns instead, so the legacy
//     schema stays byte-identical.
//   - No soft-delete columns (`deletedAt`): these are compliance/audit records,
//     and they are deliberately NOT added to `SOFT_DELETE_MODELS`.

enum AiJobStatus {
  CREATED
  PLANNED
  WAITING_APPROVAL
  READY
  RUNNING
  WAITING_HUMAN
  COMPLETED
  FAILED
  CANCELLED
  BLOCKED
}

enum AiRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiReadWriteMode {
  READ
  WRITE
}

enum AiTriggerType {
  MANUAL
  AGENT
  EVENT
  SCHEDULE
  WEBHOOK
  SYSTEM
}

enum AiAutonomyLevel {
  HUMAN
  AGENT
}

enum AiRunStatus {
  STARTED
  SUCCEEDED
  FAILED
  BLOCKED
  WAITING_APPROVAL
}

enum AiApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// One unit of requested work. Never written by the runtime directly.
model AiJob {
  id              String         @id @default(cuid())
  status          AiJobStatus    @default(CREATED)
  trigger         AiTriggerType  @default(MANUAL)
  autonomy        AiAutonomyLevel @default(HUMAN)
  capability      String
  resolvedToolId  String?
  input           Json           @default("{}")
  actorUserId     String
  businessId      String?
  correlationId   String
  approvalId      String?
  /// Run produced by the successful execution of this job.
  runId           String?
  errorCode       String?
  errorMessage    String?
  /// Serialised ExecutionContextSnapshot. Permission tokens are NEVER stored:
  /// only the actor's claims are, and tokens are re-derived on every load.
  context         Json           @default("{}")
  /// Serialised JobTransition[]. The job's own state history; the immutable
  /// ledger of the same events lives in ai_run_events.
  history         Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?
  runs            AiRun[]
  events          AiRunEvent[]

  @@index([status])
  @@index([actorUserId])
  @@index([businessId])
  @@index([correlationId])
  @@index([capability])
  @@index([runId])
  @@index([createdAt])
  @@map("ai_jobs")
}

/// One execution attempt of a job by a runtime adapter.
model AiRun {
  id                String        @id @default(cuid())
  jobId             String?
  toolId            String?
  status            AiRunStatus   @default(STARTED)
  runtimeKind       String        @default("LOCAL")
  serviceIdentityId String
  actorUserId       String
  businessId        String?
  correlationId     String
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime      @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  /// The exact call and its result, so a persisted run is self-describing.
  /// A run IS the tool invocation (one capability per run), which is why the
  /// `AiToolInvocation` table proposed in Phase 1A was removed instead of kept.
  input             Json          @default("{}")
  output            Json?
  job               AiJob?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  events            AiRunEvent[]

  @@index([jobId])
  @@index([toolId])
  @@index([status])
  @@index([actorUserId])
  @@index([correlationId])
  @@index([startedAt])
  @@map("ai_runs")
}

/// Append-only audit trail. Never updated, never deleted.
model AiRunEvent {
  id            String    @id @default(cuid())
  type          String
  runId         String?
  jobId         String?
  toolId        String?
  actorUserId   String?
  businessId    String?
  correlationId String?
  payload       Json      @default("{}")
  at            DateTime  @default(now())
  run           AiRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  job           AiJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([jobId])
  @@index([type])
  @@index([at])
  @@index([correlationId])
  @@map("ai_run_events")
}

/// Human decision gate for HIGH/CRITICAL capabilities.
/// A decision is a compare-and-set on PENDING: the first decision wins, so one
/// approval can never authorise two executions.
model AiApproval {
  id                  String           @id @default(cuid())
  status              AiApprovalStatus @default(PENDING)
  toolId              String
  jobId               String?
  runId               String?
  riskLevel           AiRiskLevel
  /// Who asked for the capability.
  requestedByUserId   String
  /// Who the decision is taken FOR (a person, unless an agent requested).
  requestedForUserId  String?
  requestReason       String
  correlationId       String?
  decidedByUserId     String?
  decisionReason      String?
  createdAt           DateTime         @default(now())
  decidedAt           DateTime?

  @@index([status])
  @@index([toolId])
  @@index([jobId])
  @@index([requestedForUserId])
  @@index([createdAt])
  @@map("ai_approvals")
}
// ═══════════════════════════════════════════════════════
// AI WORKFORCE — MISSION LIFECYCLE (Phase 2 — ADDITIVE, NOT YET MIGRATED)
// ═══════════════════════════════════════════════════════
//
// FOUR new tables for the Step-5 lifecycle: Mission → Task → ExecutionRecord →
// TaskReview. Nothing above is touched — no ALTER, no DROP, no RENAME — and no
// foreign key is declared into a legacy table (actor, business, user and
// workspace ids stay plain indexed strings), so the legacy schema stays
// byte-identical.
//
//   - The proposed DDL lives in `prisma/proposed-migrations/AI_WORKFORCE_PHASE_2/`
//     and is NOT part of `prisma/migrations/`, so `prisma migrate deploy` cannot
//     pick it up by accident.
//   - Lifecycle STATE is a validated `String`, not a Postgres enum. The state
//     machines live in TypeScript (`mission-contracts.ts`, `task-contracts.ts`,
//     `task-review.ts`) and are asserted there, so adding a state is a code
//     change rather than an `ALTER TYPE` that cannot run inside a transaction.
//   - The per-attempt audit trail is the `audit` JSON column on the execution
//     record, not a fifth table: the domain already owns that ordered array and
//     exposing it twice would create two owners for one fact. `Recent Activity`
//     reads execution records by `updatedAt`. This is the same reasoning that
//     removed the duplicating `ai_tool_invocations` table in Phase 1B.
//   - No soft-delete columns: these are compliance/audit records, deliberately
//     NOT added to `SOFT_DELETE_MODELS`.

/// A business GOAL. Sits above tasks and points at them by reference.
model AiMission {
  id           String    @id
  title        String
  goal         String
  /// Business/workspace/project/client references — opaque ids, never objects.
  businessId   String?
  workspaceRef String?
  projectRef   String?
  clientRef    String?
  /// Actor or user id that created the mission.
  createdBy    String
  /// Actor or user id accountable for the mission.
  owner        String?
  participants Json      @default("[]")
  state        String
  priority     String    @default("NORMAL")
  contextRefs  Json      @default("[]")
  jobRefs      Json      @default("[]")
  taskRefs     Json      @default("[]")
  approvals    Json      @default("[]")
  outputs      Json      @default("[]")
  /// Serialised MissionTransition[]. The mission's own state history.
  history      Json      @default("[]")
  createdAt    DateTime
  updatedAt    DateTime
  startedAt    DateTime?
  finishedAt   DateTime?

  tasks      AiTask[]
  executions AiExecutionRecord[]
  reviews    AiTaskReview[]

  @@index([state])
  @@index([businessId])
  @@index([projectRef])
  @@index([clientRef])
  @@index([createdAt])
  @@map("ai_missions")
}

/// ONE unit of work inside a mission, with the accountable actor and capability.
model AiTask {
  id                        String    @id
  missionId                 String
  /// Order inside the mission (1-based). Dependencies win over order.
  sequence                  Int
  title                     String
  objective                 String
  input                     Json      @default("{}")
  /// The actor accountable for this task. Null until assigned.
  assignedActorId           String?
  /// The capability the actor must be ASSIGNED to run.
  requiredCapabilityId      String?
  requiredCapabilityVersion String?
  /// Task ids that must be COMPLETED before this one may run.
  dependsOn                 Json      @default("[]")
  state                     String
  /// How many execution attempts have been made (0 before the first).
  attempt                   Int       @default(0)
  maxAttempts               Int       @default(2)
  /// The execution record of the CURRENT (or last) attempt.
  executionRecordId         String?
  /// The runtime handle of the current attempt, for status/cancel.
  executionHandleId         String?
  /// The review awaiting a human decision, when the task is in REVIEW.
  reviewId                  String?
  result                    Json?
  error                     Json?
  /// Serialised TaskTransition[].
  history                   Json      @default("[]")
  createdAt                 DateTime
  updatedAt                 DateTime
  startedAt                 DateTime?
  finishedAt                DateTime?

  mission    AiMission           @relation(fields: [missionId], references: [id], onDelete: Restrict)
  executions AiExecutionRecord[]
  reviews    AiTaskReview[]

  @@unique([missionId, sequence])
  @@index([missionId])
  @@index([state])
  @@index([assignedActorId])
  @@index([requiredCapabilityId])
  @@map("ai_tasks")
}

/// ONE execution ATTEMPT. The audit spine of the lifecycle.
/// `handleId` is the runtime's own handle (the bridge run id on BRIDGE);
/// `providerExecutionId` is the provider's private reference (the Hermes
/// session). They are deliberately different columns — conflating them made
/// every status/cancel call answer RUN_NOT_FOUND.
model AiExecutionRecord {
  id                  String    @id
  handleId            String
  runtimeId           String
  actorId             String
  capabilityId        String
  capabilityVersion   String?
  /// The assignment edge that authorised this attempt.
  assignmentId        String?
  missionId           String?
  taskId              String?
  /// 1-based attempt number inside the task.
  attempt             Int       @default(1)
  providerExecutionId String?
  status              String
  /// The key that made this attempt idempotent, when one applied.
  idempotencyKey      String?
  /// True when the runtime answered an idempotent replay: no new real run.
  replayed            Boolean   @default(false)
  startedAt           DateTime
  updatedAt           DateTime
  completedAt         DateTime?
  durationMs          Int?
  /// The structured result. `output` is the parsed shape; `outputText` the raw
  /// bounded provider text. Both travel because a provider may send one or the
  /// other, and the audit needs whichever it sent.
  output              Json?
  outputText          String?
  error               Json?
  cancelledAt         DateTime?
  cancelledReason     String?
  /// Serialised ExecutionAuditEvent[]. Ordered, append-only per attempt.
  audit               Json      @default("[]")
  createdAt           DateTime  @default(now())

  mission AiMission? @relation(fields: [missionId], references: [id], onDelete: Restrict)
  task    AiTask?    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  reviews AiTaskReview[]

  @@unique([taskId, attempt])
  @@index([handleId])
  @@index([providerExecutionId])
  @@index([idempotencyKey])
  @@index([status])
  @@index([runtimeId])
  @@index([actorId])
  @@index([missionId])
  @@index([taskId])
  @@index([updatedAt])
  @@map("ai_execution_records")
}

//
// ONE more table for Step 5's application boundary: the Command IDEMPOTENCY
// ledger.
//
//   - Additive like the rest: one CREATE TABLE, its indexes, no ALTER against
//     any existing table. The proposed DDL lives in
//     `prisma/proposed-migrations/AI_WORKFORCE_PHASE_3/` and is NOT part of
//     `prisma/migrations/`, so `prisma migrate deploy` cannot pick it up.
//   - Provider-neutral on purpose: the ledger knows a SCOPE and an opaque
//     idempotency key, never a provider, a transport or a model. Two retries of
//     the same Command must land on the same Mission; a genuinely new Command
//     must still create a new one.
//   - The unique index on (scope, idempotencyKey) IS the algorithm: the claim is
//     a single INSERT, so two concurrent callers cannot both win. No advisory
//     locks, no read-then-write race.
//   - `commandHash` makes a reused key with a DIFFERENT payload a refusal, not a
//     silent replay of someone else's work.
//   - `missionId` is the reference to the Mission the claim produced. The
//     ledger never embeds the mission.

/// The Command idempotency ledger — at most one Mission per (scope, key).
model AiCommandIntent {
  id             String   @id
  /// Caller-owned namespace for the key (a business/actor scope, never model output).
  scope          String
  /// The caller's retry token. Opaque to this system.
  idempotencyKey String
  /// sha256 of the canonical command payload: a reused key with a different body is refused.
  commandHash    String
  /// CLAIMED → COMPLETED | FAILED. Validated by the application state machine.
  state          String   @default("CLAIMED")
  /// The Mission this claim owns, once it exists.
  missionId      String?
  requestedBy    String
  capabilityId   String?
  reason         String?
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([scope, idempotencyKey])
  @@index([missionId])
  @@index([state])
  @@index([createdAt])
  @@map("ai_command_intents")
}

/// The HUMAN AUTHORITY boundary. An agent's result is not a decision.
/// A decision is a compare-and-set on PENDING: the first one wins, so a review
/// can never be decided twice.
model AiTaskReview {
  id                String    @id
  taskId            String
  missionId         String
  /// The attempt whose result is under review.
  executionRecordId String
  state             String    @default("PENDING")
  /// Why the review exists (what the agent produced, in one bounded line).
  summary           String
  /// Who must decide.
  reviewerActorId   String?
  requestedBy       String
  requestedAt       DateTime
  decidedBy         String?
  decidedAt         DateTime?
  note              String?

  task      AiTask            @relation(fields: [taskId], references: [id], onDelete: Restrict)
  mission   AiMission         @relation(fields: [missionId], references: [id], onDelete: Restrict)
  execution AiExecutionRecord @relation(fields: [executionRecordId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([missionId])
  @@index([state])
  @@index([requestedAt])
  @@index([reviewerActorId])
  @@map("ai_task_reviews")
}
