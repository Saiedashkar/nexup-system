generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN   // Office owner — sees all businesses
  ADMIN         // Business manager — full access to one business
  EMPLOYEE      // Staff — clients only, within one business
}

enum CurrencyMode {
  SAR_TO_EGP   // Saudi Riyal → Egyptian Pound (NEXUP)
  EGP_DIRECT   // Egyptian Pound direct (REBOUND, ABOMAZEN)
}

enum ClientTier {
  VIP
  LOYAL
  NORMAL
  DELINQUENT
}

enum WorkStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum PaymentStatus {
  FULL
  PARTIAL
  UNPAID
}

enum PoolTransactionType {
  IN
  OUT
}

enum ExpenseCategory {
  FIXED
  VARIABLE
}

enum ClientType {
  ONE_TIME    // One-time service
  RECURRING   // Monthly subscription
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  PARTIAL
}

// ═══════════════════════════════════════════════════════
// Business (multi-business support)
// ═══════════════════════════════════════════════════════

model Business {
  id            String         @id @default(cuid())
  name          String         @unique  // "NEXUP", "REBOUND", "ABOMAZEN"
  slug          String         @unique  // "nexup", "rebound", "abomazen"
  currencyMode  CurrencyMode   @default(SAR_TO_EGP)
  createdAt     DateTime       @default(now())

  // Relations — each business has its own isolated data
  users             User[]
  clients           Client[]
  serviceTypes      ServiceType[]
  projectRecords    ProjectRecord[]
  poolTransactions  PoolTransaction[]
  withdrawals       Withdrawal[]
  expenses          Expense[]
  // Subscription relations
  subscriptions          Subscription[]
  // ABOMAZEN relations
  properties             Property[]
  deals                  Deal[]
  // Office admin relations
  ownerships             BusinessOwnership[]
  partnerTransactions    PartnerTransaction[]
  allocationSettings     OfficeAllocationSetting[]
  profitTransfers        ProfitTransfer[]

  @@index([slug])
}

// ═══════════════════════════════════════════════════════
// Core Models
// ═══════════════════════════════════════════════════════

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role            @default(EMPLOYEE)
  businessId     String?         // null for SUPER_ADMIN (sees all)
  // ─── Permission Flags ───
  canAccessNexup            Boolean @default(false)
  canAccessRebound          Boolean @default(false)
  canAccessAbomazen         Boolean @default(false)
  canAccessOfficeFinanceFull Boolean @default(false)
  mustChangePassword Boolean @default(false)
  createdAt      DateTime        @default(now())
  business       Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  projectRecords ProjectRecord[] @relation("DesignerProjects")
  activityLogs   ActivityLog[]

  @@index([role])
  @@index([businessId])
}

model Client {
  id             String          @id @default(cuid())
  businessId     String
  phone          String          // Not unique globally — unique per business
  name           String
  tier           ClientTier      @default(NORMAL)
  createdAt      DateTime        @default(now())
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecords ProjectRecord[]
  subscriptions  Subscription[]

  @@unique([businessId, phone])
  @@index([name])
  @@index([businessId])

  // Soft delete (safe delete — never destroy real financial data)
  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model ServiceType {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  isCustom       Boolean         @default(false)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecords ProjectRecord[]

  @@unique([businessId, name, isCustom])
  @@index([businessId])
}

model ProjectRecord {
  id               String            @id @default(cuid())
  businessId       String
  clientId         String
  projectName      String
  date             DateTime
  customServiceText String?
  totalPrice       Decimal           @db.Decimal(12, 2)
  deposit          Decimal           @default(0) @db.Decimal(12, 2)
  remaining        Decimal           @default(0) @db.Decimal(12, 2)
  workStatus       WorkStatus        @default(WAITING)
  paymentStatus    PaymentStatus     @default(UNPAID)
  designerId       String?
  designerName     String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  designer         User?             @relation("DesignerProjects", fields: [designerId], references: [id], onDelete: Restrict)
  services         ServiceType[]
  poolTransactions PoolTransaction[]
  payments         ClientPayment[]
  clientType       ClientType        @default(ONE_TIME)

  @@index([businessId])
  @@index([clientId])
  @@index([designerId])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model PoolTransaction {
  id              String              @id @default(cuid())
  businessId      String
  projectRecordId String?
  dealId          String?
  withdrawalId    String?             @unique
  amountSAR       Decimal             @db.Decimal(12, 2)
  type            PoolTransactionType
  date            DateTime
  note            String?
  createdAt       DateTime            @default(now())
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecord   ProjectRecord?      @relation(fields: [projectRecordId], references: [id], onDelete: SetNull)
  deal            Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  withdrawal      Withdrawal?         @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([projectRecordId])
  @@index([type])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model Withdrawal {
  id              String           @id @default(cuid())
  businessId      String
  amountSAR       Decimal          @db.Decimal(12, 2)
  exchangeRate    Decimal          @db.Decimal(12, 4)
  commissionPct   Decimal          @default(10) @db.Decimal(5, 2)
  netEGP          Decimal          @db.Decimal(14, 2)
  date            DateTime
  month           Int
  year            Int
  createdAt       DateTime         @default(now())
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  poolTransaction PoolTransaction?

  @@index([businessId])
  @@index([year, month])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model Expense {
  id          String          @id @default(cuid())
  businessId  String
  description String
  cost        Decimal         @db.Decimal(14, 2)
  category    ExpenseCategory
  name        String
  notes       String?
  date        DateTime
  month       Int
  year        Int
  createdAt   DateTime        @default(now())
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([year, month])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model ClientPayment {
  id              String          @id @default(cuid())
  projectRecordId String
  amount          Decimal         @db.Decimal(12, 2)
  date            DateTime
  note            String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  projectRecord   ProjectRecord   @relation(fields: [projectRecordId], references: [id], onDelete: Restrict)
  receipts        PaymentReceipt[]

  @@index([projectRecordId])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model PaymentReceipt {
  id               String        @id @default(cuid())
  clientPaymentId  String
  imageUrl         String
  fileName         String?
  fileSize         Int?
  mimeType         String?
  uploadedAt       DateTime      @default(now())
  uploadedByUserId String?
  clientPayment    ClientPayment @relation(fields: [clientPaymentId], references: [id], onDelete: Cascade)

  @@index([clientPaymentId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

// ═════════════════════════════════════════════════════
// Phase 2B — pending confirmation for sensitive ("Red") MCP actions
// ═════════════════════════════════════════════════════

// Two-step confirmation gate for high-impact MCP actions. prepare_*
// persists a server-side intent snapshot (args + computed preview +
// precondition fingerprint) and hands the caller a one-time token;
// confirm_* consumes the row and executes the business mutation in a
// SINGLE database transaction. v1 requires the same MCP principal for
// prepare and confirm, and confirmation happens at the conversational
// layer — the token proves same-agent continuation, NOT human
// approval. A trusted approval channel (dashboard, Telegram, …) can
// later add a real APPROVED state without redesign: the approval
// columns below are pre-declared and unused in v1.
// Like McpAuditLog, this table deliberately has NO foreign keys so it
// can never add a RESTRICT constraint that blocks a business
// operation.
model McpPendingAction {
  id          String   @id @default(cuid())

  // Actor that prepared the intent (confirm must match in v1).
  actor       String
  actorName   String

  // What will happen (from the classification registry).
  tool        String
  actionType  String
  entityType  String
  entityId    String?

  // Scope binding — checked again at confirm.
  businessId  String
  businessSlug String

  // Validated, canonical, non-secret arguments (executed as-is).
  argsSnapshot Json

  // Human-readable effect summary + computed numbers for the summary.
  preview     Json

  // Preconditions re-checked inside the confirm transaction
  // (e.g. { "ProjectRecord:cmug…": { "updatedAt": …, "remaining": … } }).
  preconditionFingerprint Json?

  // Integrity/diagnostics: SHA-256 of the canonical args JSON.
  requestHash String

  // One-time token — only its SHA-256 is ever stored. Plaintext is
  // returned exactly once in the prepare response, never logged,
  // audited or persisted.
  confirmTokenHash String
  attempts    Int      @default(0)

  status      String   @default("PENDING") // PENDING | EXECUTED | EXPIRED | FAILED (| APPROVED future)

  expiresAt   DateTime
  confirmedAt DateTime?
  executedAt  DateTime?
  resultAuditLogId String?

  // Future trusted-approval channel (NOT used in v1, additive now so
  // the later migration touches nothing existing).
  approvalChannel String?
  approvedAt      DateTime?
  approvedBy      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([actor])
  @@index([businessId])
  @@index([entityType, entityId])
}

// Audit trail for MCP (Hermes) writes. Deliberately separate from
// ActivityLog, which requires a real human User FK: MCP acts as a
// machine principal, so no human row is faked and the ActivityLog
// foreign key is left exactly as-is. Intentionally has NO foreign keys
// at all — the trail is append-only history that must survive, and it
// must never introduce a new RESTRICT constraint that could block a
// user/business operation. Every row names exactly one business.
model McpAuditLog {
  id           String   @id @default(cuid())
  source       String   @default("MCP/Hermes")
  actor        String // MCP principal id (never a human User id)
  actorName    String // MCP principal display name
  tool         String // create_client | update_client | create_project | update_project
  action       String // CREATE | UPDATE
  entityType   String // Client | ProjectRecord
  entityId     String
  businessId   String
  businessSlug String
  metadata     Json? // non-secret change details only
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tool])
}

// ═══════════════════════════════════════════════════════
// Office Administration Layer (SUPER_ADMIN only)
// ═══════════════════════════════════════════════════════

enum PartnerTransactionType {
  SALARY          // Fixed monthly salary
  PROFIT_SHARE    // Share of distributed profits
  ADVANCE         // Cash advance (deducted from future earnings)
  WITHDRAWAL      // Normal withdrawal
  LOAN_SETTLEMENT // Settlement/deduction of previous advance
}

enum CapitalType {
  CASH
  ASSET
}

enum FundFlow {
  SPENT_ALREADY     // Money was spent immediately — does NOT add to treasury
  STILL_IN_TREASURY // Money is available as real cash in the office treasury
}

enum ExpenseCat {
  FIXED
  VARIABLE
}

model Partner {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  ownerships          BusinessOwnership[]
  transactions        PartnerTransaction[]
  capitalContributions CapitalContribution[]
  nexupProfitDistributions NexupProfitLedger[]
}

model BusinessOwnership {
  id            String   @id @default(cuid())
  partnerId     String
  businessId    String
  ownershipPct  Float    // percentage 0-100
  effectiveDate DateTime @default(now())
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([partnerId, businessId, effectiveDate])
  @@index([partnerId])
  @@index([businessId])
}

model PartnerTransaction {
  id          String                @id @default(cuid())
  partnerId   String
  type        PartnerTransactionType
  amount      Float
  date        DateTime
  businessId  String?               // null = general office transaction
  note        String?
  createdAt   DateTime              @default(now())
  partner     Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  business    Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([businessId])
  @@index([date])
  @@index([type])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model OfficeExpense {
  id          String     @id @default(cuid())
  description String
  cost        Float
  category    ExpenseCat
  name        String     // recipient/person
  notes       String?
  date        DateTime
  month       Int
  year        Int
  createdAt   DateTime   @default(now())

  @@index([year, month])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model CapitalContribution {
  id               String      @id @default(cuid())
  partnerId        String
  amount           Float
  type             CapitalType
  fundFlow         FundFlow    @default(SPENT_ALREADY)
  description      String?
  date             DateTime
  linkedExpenseId  String?     // Auto-created OfficeExpense ID (for SPENT_ALREADY)
  createdAt        DateTime    @default(now())
  partner          Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@index([date])
  @@index([fundFlow])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model OfficeAllocationSetting {
  id            String   @id @default(cuid())
  businessId    String
  allocationPct Float    // percentage this business pays of office expenses
  effectiveDate DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, effectiveDate])
  @@index([businessId])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model ProfitTransfer {
  id          String   @id @default(cuid())
  businessId  String
  amount      Float    // EGP transferred from business profit to office treasury
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// NEXUP Profit Distribution (SAIED & ADEL only)
// ═══════════════════════════════════════════════════════

model NexupProfitLedger {
  id          String   @id @default(cuid())
  partnerId   String   // Must be SAIED or ADEL — enforced at API level
  amount      Float    // EGP distributed from NEXUP treasury
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@index([date])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// ABOMAZEN Properties & Deals (Real Estate Brokerage)
// ═══════════════════════════════════════════════════════

model Property {
  id            String    @id @default(cuid())
  businessId    String
  ownerName     String
  ownerPhone    String?
  propertyType  String    // شقة، فيلا، محل... (free text)
  location      String
  listingType   String    @default("RENT") // RENT or SALE
  askingPrice   Float?
  status        String    @default("AVAILABLE") // AVAILABLE, RENTED, SOLD
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deals         Deal[]

  @@index([businessId])
  @@index([status])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model Deal {
  id                   String    @id @default(cuid())
  businessId           String
  propertyId           String?
  dealType             String    // RENT or SALE
  dealValue            Float?
  totalCommission      Float     // Total commission collected (required)
  externalOfficeAmount Float?
  personalAmount       Float?
  abomazenNetAmount    Float     // Net amount that enters ABOMAZEN balance (required)
  date                 DateTime
  seekerName           String?
  seekerPhone          String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  property             Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  poolTransactions     PoolTransaction[]

  @@index([businessId])
  @@index([propertyId])
  @@index([date])
  @@index([dealType])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// REBOUND Subscriptions
// ═══════════════════════════════════════════════════════

model Subscription {
  id            String              @id @default(cuid())
  clientId      String
  businessId    String
  services      String              // JSON array of service names
  monthlyFee    Float
  startDate     DateTime
  billingDay    Int                 @default(1) // Day of month for billing
  status        SubscriptionStatus  @default(ACTIVE)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invoices      SubscriptionInvoice[]

  @@index([clientId])
  @@index([businessId])
  @@index([status])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model SubscriptionInvoice {
  id              String          @id @default(cuid())
  subscriptionId  String
  month           Int
  year            Int
  amount          Float           // Defaults to monthlyFee at generation time
  status          InvoiceStatus   @default(UNPAID)
  paidAmount      Float           @default(0)
  paidDate        DateTime?
  createdAt       DateTime        @default(now())
  subscription    Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, month, year])
  @@index([subscriptionId])
  @@index([month, year])
  @@index([status])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════
// Office Tools & Equipment (managed from capital)
// ═══════════════════════════════════════════════════════

enum ToolType {
  ONE_TIME            // Purchased once from capital
  MONTHLY_SUBSCRIPTION // Recurring monthly cost
  PERIODIC            // Recurring at irregular intervals
}

enum ToolStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model OfficeTool {
  id              String     @id @default(cuid())
  name            String     // e.g. "Adobe Photoshop", "Office Desk"
  type            ToolType   @default(ONE_TIME)
  category        String     // e.g. "Software", "Hardware", "Furniture"
  cost            Float      // Purchase price or monthly subscription cost
  purchaseDate    DateTime   // When purchased or subscription started
  nextDueDate     DateTime?  // Next payment due (for MONTHLY_SUBSCRIPTION & PERIODIC)
  intervalDays    Int?       // For PERIODIC: days between payments
  status          ToolStatus @default(ACTIVE)
  paidBy          String     @default("CAPITAL") // CAPITAL or PARTNER name
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  payments        OfficeToolPayment[]

  @@index([type])
  @@index([status])
  @@index([category])
  @@index([nextDueDate])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}

model OfficeToolPayment {
  id          String     @id @default(cuid())
  toolId      String
  amount      Float
  paidDate    DateTime
  notes       String?
  createdAt   DateTime   @default(now())
  tool        OfficeTool @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@index([toolId])
  @@index([paidDate])

  deletedAt       DateTime?
  deletedByUserId String?
  @@index([deletedAt])
}
