generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN   // Office owner — sees all businesses
  ADMIN         // Business manager — full access to one business
  EMPLOYEE      // Staff — clients only, within one business
}

enum CurrencyMode {
  SAR_TO_EGP   // Saudi Riyal → Egyptian Pound (NEXUP)
  EGP_DIRECT   // Egyptian Pound direct (REBOUND, ABOMAZEN)
}

enum ClientTier {
  VIP
  LOYAL
  NORMAL
  DELINQUENT
}

enum WorkStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum PaymentStatus {
  FULL
  PARTIAL
  UNPAID
}

enum PoolTransactionType {
  IN
  OUT
}

enum ExpenseCategory {
  FIXED
  VARIABLE
}

// ═══════════════════════════════════════════════════════
// Business (multi-business support)
// ═══════════════════════════════════════════════════════

model Business {
  id            String         @id @default(cuid())
  name          String         @unique  // "NEXUP", "REBOUND", "ABOMAZEN"
  slug          String         @unique  // "nexup", "rebound", "abomazen"
  currencyMode  CurrencyMode   @default(SAR_TO_EGP)
  createdAt     DateTime       @default(now())

  // Relations — each business has its own isolated data
  users             User[]
  clients           Client[]
  serviceTypes      ServiceType[]
  projectRecords    ProjectRecord[]
  poolTransactions  PoolTransaction[]
  withdrawals       Withdrawal[]
  expenses          Expense[]
  // Office admin relations
  ownerships             BusinessOwnership[]
  partnerTransactions    PartnerTransaction[]
  allocationSettings     OfficeAllocationSetting[]

  @@index([slug])
}

// ═══════════════════════════════════════════════════════
// Core Models
// ═══════════════════════════════════════════════════════

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role            @default(EMPLOYEE)
  businessId     String?         // null for SUPER_ADMIN (sees all)
  createdAt      DateTime        @default(now())
  business       Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  projectRecords ProjectRecord[] @relation("DesignerProjects")
  activityLogs   ActivityLog[]

  @@index([role])
  @@index([businessId])
}

model Client {
  id             String          @id @default(cuid())
  businessId     String
  phone          String          // Not unique globally — unique per business
  name           String
  tier           ClientTier      @default(NORMAL)
  createdAt      DateTime        @default(now())
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecords ProjectRecord[]

  @@unique([businessId, phone])
  @@index([name])
  @@index([businessId])
}

model ServiceType {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  isCustom       Boolean         @default(false)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecords ProjectRecord[]

  @@unique([businessId, name, isCustom])
  @@index([businessId])
}

model ProjectRecord {
  id               String            @id @default(cuid())
  businessId       String
  clientId         String
  projectName      String
  date             DateTime
  customServiceText String?
  totalPrice       Decimal           @db.Decimal(12, 2)
  deposit          Decimal           @default(0) @db.Decimal(12, 2)
  remaining        Decimal           @default(0) @db.Decimal(12, 2)
  workStatus       WorkStatus        @default(WAITING)
  paymentStatus    PaymentStatus     @default(UNPAID)
  designerId       String?
  designerName     String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  designer         User?             @relation("DesignerProjects", fields: [designerId], references: [id], onDelete: Restrict)
  services         ServiceType[]
  poolTransactions PoolTransaction[]
  payments         ClientPayment[]

  @@index([businessId])
  @@index([clientId])
  @@index([designerId])
  @@index([date])
}

model PoolTransaction {
  id              String              @id @default(cuid())
  businessId      String
  projectRecordId String?
  withdrawalId    String?             @unique
  amountSAR       Decimal             @db.Decimal(12, 2)
  type            PoolTransactionType
  date            DateTime
  note            String?
  createdAt       DateTime            @default(now())
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  projectRecord   ProjectRecord?      @relation(fields: [projectRecordId], references: [id], onDelete: SetNull)
  withdrawal      Withdrawal?         @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([projectRecordId])
  @@index([type])
  @@index([date])
}

model Withdrawal {
  id              String           @id @default(cuid())
  businessId      String
  amountSAR       Decimal          @db.Decimal(12, 2)
  exchangeRate    Decimal          @db.Decimal(12, 4)
  commissionPct   Decimal          @default(10) @db.Decimal(5, 2)
  netEGP          Decimal          @db.Decimal(14, 2)
  date            DateTime
  month           Int
  year            Int
  createdAt       DateTime         @default(now())
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  poolTransaction PoolTransaction?

  @@index([businessId])
  @@index([year, month])
  @@index([date])
}

model Expense {
  id          String          @id @default(cuid())
  businessId  String
  description String
  cost        Decimal         @db.Decimal(14, 2)
  category    ExpenseCategory
  name        String
  notes       String?
  date        DateTime
  month       Int
  year        Int
  createdAt   DateTime        @default(now())
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([year, month])
  @@index([date])
}

model ClientPayment {
  id              String          @id @default(cuid())
  projectRecordId String
  amount          Decimal         @db.Decimal(12, 2)
  date            DateTime
  note            String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  projectRecord   ProjectRecord   @relation(fields: [projectRecordId], references: [id], onDelete: Restrict)

  @@index([projectRecordId])
  @@index([date])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

// ═══════════════════════════════════════════════════════
// Office Administration Layer (SUPER_ADMIN only)
// ═══════════════════════════════════════════════════════

enum PartnerTransactionType {
  SALARY          // Fixed monthly salary
  PROFIT_SHARE    // Share of distributed profits
  ADVANCE         // Cash advance (deducted from future earnings)
  WITHDRAWAL      // Normal withdrawal
  LOAN_SETTLEMENT // Settlement/deduction of previous advance
}

enum CapitalType {
  CASH
  ASSET
}

enum ExpenseCat {
  FIXED
  VARIABLE
}

model Partner {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  ownerships          BusinessOwnership[]
  transactions        PartnerTransaction[]
  capitalContributions CapitalContribution[]
}

model BusinessOwnership {
  id            String   @id @default(cuid())
  partnerId     String
  businessId    String
  ownershipPct  Float    // percentage 0-100
  effectiveDate DateTime @default(now())
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([partnerId, businessId, effectiveDate])
  @@index([partnerId])
  @@index([businessId])
}

model PartnerTransaction {
  id          String                @id @default(cuid())
  partnerId   String
  type        PartnerTransactionType
  amount      Float
  date        DateTime
  businessId  String?               // null = general office transaction
  note        String?
  createdAt   DateTime              @default(now())
  partner     Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  business    Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([businessId])
  @@index([date])
  @@index([type])
}

model OfficeExpense {
  id          String     @id @default(cuid())
  description String
  cost        Float
  category    ExpenseCat
  name        String     // recipient/person
  notes       String?
  date        DateTime
  month       Int
  year        Int
  createdAt   DateTime   @default(now())

  @@index([year, month])
  @@index([date])
}

model CapitalContribution {
  id          String      @id @default(cuid())
  partnerId   String
  amount      Float
  type        CapitalType
  description String?
  date        DateTime
  createdAt   DateTime    @default(now())
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@index([date])
}

model OfficeAllocationSetting {
  id            String   @id @default(cuid())
  businessId    String
  allocationPct Float    // percentage this business pays of office expenses
  effectiveDate DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, effectiveDate])
  @@index([businessId])
}
